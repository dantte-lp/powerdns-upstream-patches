# Containerfile.dev — terraform-provider-powerdns development image.
#
# Spec: Containerfile.5
#   https://github.com/containers/common/blob/main/docs/Containerfile.5.md
# Buildable natively with Buildah and `podman build`; no external frontend.
#
# Build:   podman build -f deployments/containers/Containerfile.dev -t terraform-provider-powerdns-dev:local .
# Run via: deployments/compose/compose.dev.yml (Compose Specification).
#
# Everything the daily loop needs is baked in: Go toolchain, golangci-lint v2,
# govulncheck, osv-scanner, gotestsum, Terraform + OpenTofu + Terragrunt,
# tfplugindocs, goreleaser, the uv/ruff/ty Python toolchain, and the
# documentation linters. The host needs only Podman and podman-compose.

ARG GO_VERSION=1.26
ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG GOVULNCHECK_VERSION=v1.6.0
ARG OSV_SCANNER_VERSION=v2.4.0
ARG TFPLUGINDOCS_VERSION=v0.25.0
ARG GORELEASER_VERSION=v2.17.1
ARG TERRAFORM_VERSION=1.15.8
ARG OPENTOFU_VERSION=1.12.5
ARG TERRAGRUNT_VERSION=1.1.1
ARG NODE_MAJOR=22
ARG PODMAN_PY_VERSION=5.7.0
ARG UV_VERSION=0.11.33
ARG RUFF_VERSION=0.16.0
ARG TY_VERSION=0.0.64

FROM golang:1.26-trixie AS dev

ARG GOLANGCI_LINT_VERSION
ARG GOVULNCHECK_VERSION
ARG OSV_SCANNER_VERSION
ARG TFPLUGINDOCS_VERSION
ARG GORELEASER_VERSION
ARG TERRAFORM_VERSION
ARG OPENTOFU_VERSION
ARG TERRAGRUNT_VERSION
ARG NODE_MAJOR
ARG PODMAN_PY_VERSION
ARG UV_VERSION
ARG RUFF_VERSION
ARG TY_VERSION

# TF_ACC is unset by default: acceptance tests run only when the caller opts in
# with TF_ACC=1 and points PDNS_SERVER_URL at the lab. See AGENTS.md.
ENV GOFLAGS="-buildvcs=false" \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/go/pkg/mod \
    CHECKPOINT_DISABLE=1 \
    TF_IN_AUTOMATION=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="terraform-provider-powerdns-dev" \
      org.opencontainers.image.description="Development image for terraform-provider-powerdns." \
      org.opencontainers.image.source="https://github.com/dantte-lp/terraform-provider-powerdns" \
      org.opencontainers.image.licenses="MPL-2.0"

# Base OS tooling.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        tzdata \
        make \
        bash \
        curl \
        unzip \
        jq \
        gnupg \
        dnsutils \
        postgresql-client \
        python3 \
        python3-pip \
 && rm -rf /var/lib/apt/lists/*

# dnsutils and postgresql-client are not incidental: acceptance tests assert
# that a record is actually resolvable and that the backend row exists, which
# an HTTP 200 alone does not prove.

# Node.js for the npm-based documentation linters.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && chmod a+r /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# Terraform, OpenTofu and Terragrunt (pinned). Both engines are installed so
# examples and acceptance runs can be exercised against either.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) tfarch=amd64 ;; arm64) tfarch=arm64 ;; *) echo "unsupported arch $arch" >&2; exit 1 ;; esac; \
    curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${tfarch}.zip" -o /tmp/tf.zip; \
    unzip -d /usr/local/bin /tmp/tf.zip; \
    curl -fsSL "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_${tfarch}.zip" -o /tmp/tofu.zip; \
    unzip -d /usr/local/bin /tmp/tofu.zip tofu; \
    curl -fsSL "https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/terragrunt_linux_${tfarch}" -o /usr/local/bin/terragrunt; \
    chmod +x /usr/local/bin/terragrunt; \
    rm -f /tmp/tf.zip /tmp/tofu.zip; \
    terraform version; tofu version; terragrunt --version

# Go tooling (pinned).
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION} \
 && go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
 && go install github.com/google/osv-scanner/v2/cmd/osv-scanner@${OSV_SCANNER_VERSION} \
 && go install github.com/hashicorp/terraform-plugin-docs/cmd/tfplugindocs@${TFPLUGINDOCS_VERSION} \
 && go install github.com/goreleaser/goreleaser/v2@${GORELEASER_VERSION} \
 && go install golang.org/x/tools/gopls@latest \
 && go install gotest.tools/gotestsum@latest

# npm-based documentation linters.
RUN --mount=type=cache,target=/root/.npm \
    npm install -g \
        markdownlint-cli2@latest \
        cspell@latest \
        @commitlint/cli@latest \
        @commitlint/config-conventional@latest

# Python tooling. uv is the installer and environment manager; ruff and ty are
# the Python quality gates, matching what golangci-lint is for Go. ty is
# pre-1.0 and pinned exactly for that reason.
RUN --mount=type=cache,target=/root/.cache/uv \
    curl -fsSL https://astral.sh/uv/${UV_VERSION}/install.sh | sh \
 && mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/ \
 && uv --version

RUN --mount=type=cache,target=/root/.cache/uv \
    uv tool install --python 3.12 "ruff==${RUFF_VERSION}" \
 && uv tool install --python 3.12 "ty==${TY_VERSION}" \
 && uv tool install --python 3.12 yamllint \
 && uv tool install --python 3.12 junit2html \
 && uv tool update-shell || true

ENV PATH="/root/.local/bin:${PATH}"

# podman-py is a runtime dependency of the lab automation, not a tool, so it
# goes into the interpreter the scripts run under.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages "podman==${PODMAN_PY_VERSION}"

WORKDIR /app
VOLUME /app

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD pgrep -x sleep >/dev/null || exit 1

CMD ["sleep", "infinity"]
